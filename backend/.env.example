# OLYMPOS Phase 0 — 環境変数テンプレート
# 使い方: このファイルをコピーして backend/.env を作り、値を書き込む。
#   cp backend/.env.example backend/.env
# backend/.env は Git にコミットしないこと。

# --- アプリ ---
OLYMPOS_ENV=development
OLYMPOS_DB_PATH=./data/olympos_phase0.db
OLYMPOS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 外部公開で画面とAPIを分ける場合は公開URLを追加。同一サービスなら * でも可
# OLYMPOS_CORS_ORIGINS=*

# --- AI似顔絵 ---
# mock: 外部送信なし（既定）
# http: PORTRAIT_API_URL / PORTRAIT_API_KEY が必須
PORTRAIT_PROVIDER=mock
PORTRAIT_API_URL=
PORTRAIT_API_KEY=
PORTRAIT_DELETE_AFTER_SECONDS=3600
